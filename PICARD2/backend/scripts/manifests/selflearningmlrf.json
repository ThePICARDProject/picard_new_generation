{
  "protocol": "spark-classification-v1",
  "input_description": "CSV with a header, numeric feature columns, and the class label in the last column. Labels must be 0 and 1 (the stratified split only handles these two keys). Use fully labelled data; the program hides labels itself according to 'Labelled data (%)'.",
  "parameters": [
    {
      "name": "numClasses",
      "label": "Number of classes",
      "type": "integer",
      "default": 2,
      "min": 2,
      "max": 2
    },
    {
      "name": "numTrees",
      "label": "Number of trees",
      "type": "integer",
      "default": 10,
      "min": 1,
      "max": 2147483647
    },
    {
      "name": "impurity",
      "label": "Impurity measure",
      "type": "choice",
      "default": "gini",
      "choices": [
        "gini",
        "entropy"
      ]
    },
    {
      "name": "maxDepth",
      "label": "Maximum tree depth",
      "type": "integer",
      "default": 5,
      "min": 0,
      "max": 30
    },
    {
      "name": "maxBins",
      "label": "Maximum bins",
      "type": "integer",
      "default": 32,
      "min": 2,
      "max": 2147483647
    },
    {
      "name": "percentLabeled",
      "label": "Labelled data (%)",
      "type": "number",
      "default": 70,
      "exclusiveMin": 0,
      "max": 100
    }
  ]
}