# Total capacity advertised by the Spark worker
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

# Resources requested by each Spark application
SPARK_EXECUTOR_CORES=1
SPARK_EXECUTOR_MEMORY=1g
SPARK_MAX_CORES=2
SPARK_DRIVER_MEMORY=1g

# Container hosting Celery and the Spark driver
CELERY_CPU_LIMIT=2
CELERY_MEMORY_LIMIT=3G
CELERY_CONCURRENCY=1
