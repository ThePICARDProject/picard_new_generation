# Total capacity advertised by the Spark worker
SPARK_WORKER_CORES=16
SPARK_WORKER_MEMORY=64G

# Resources requested by each Spark application
SPARK_EXECUTOR_CORES=4
SPARK_EXECUTOR_MEMORY=16g
SPARK_MAX_CORES=16
SPARK_DRIVER_MEMORY=4g

# Container hosting Celery and the Spark driver
CELERY_CPU_LIMIT=4
CELERY_MEMORY_LIMIT=8G
CELERY_CONCURRENCY=1
